# Copy to .dev.vars (in shop/) for local testing with `npx wrangler dev`. .dev.vars is not committed.
# Don't put any keys in code. See https://docs.stripe.com/keys-best-practices.
# Get the test key from the Stripe Dashboard -> https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:8787/api/webhook` (local) or the Dashboard -> Webhooks (live)
STRIPE_WEBHOOK_SECRET=whsec_...
# The address wrangler dev serves the shop on
SITE_URL=http://localhost:8787
